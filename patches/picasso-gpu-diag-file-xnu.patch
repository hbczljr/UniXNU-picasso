+	{
+		extern int picasso_console_record_save(const char *tag);
+		extern volatile int native_owner_data_stage;
+		static unsigned activations;
+		/* Round 20: round 16 reached SpringBoard and advanced the record 53 times;
+		 * rounds 17-19 each advanced it once (the mount probe) even after the
+		 * userspace change was reverted, so after mounting fewer than eight image
+		 * activations happen at all. Name the first twelve so the record itself
+		 * says whether the system launches anything, and how far it gets. */
+		if (native_owner_data_stage == 4 && ++activations <= 12) {
+			printf("PICASSO_EXECN n=%u pid=%d name=%s\n", activations,
+			    proc_pid(p), p->p_name);
+		}
+		/* Round 21: save on the first twelve activations too. Round 20 named them
+		 * on the console but only saved every eighth, so a boot that stopped at
+		 * activations 1..7 left no trace in the record at all -- which is exactly
+		 * the case left to distinguish. */
+		if (native_owner_data_stage == 4 &&
+		    (activations <= 12 || activations % 8 == 0)) {
+			int saveResult = picasso_console_record_save("exec");
+			if (activations == 1 || activations == 8)
+				printf("PICASSO_LOG exec-save n=%u result=%d\n", activations, saveResult);

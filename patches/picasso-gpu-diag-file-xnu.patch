+/* Round 10: durable GPU snapshot for a boot whose USB console dies (~91 s)
+ * and whose unified log is flooded by bluetoothd. Round 11 keeps the writer
+ * but fixes the two things round 10 could not tell apart, because its file
+ * never appeared: the single hard-coded path and the caller's context.
+ *
+ * So the write walks a short path list instead, mobile-owned first: the
+ * ca-preferences write proves a file under /private/var/mobile is creatable
+ * from kernel exec context, while the volume root (/private/var) may be
+ * root-owned and out of reach for a mobile-credential caller. The first
+ * directory that accepts the file wins and its 1-based index is returned, so
+ * the USB console reports the winner while it still lives. */
+static int
+native_picasso_gpu_diag_write_one(const char *path, const char *text, int length)
+{
+	vfs_context_t ctx = vfs_context_current();
+	vnode_t vp = NULLVP;
+	int error;
+	error = vnode_open(path, O_CREAT | O_TRUNC | FWRITE | O_NOFOLLOW, 0644, 0, &vp, ctx);
+	if (error) {
+		return error;
+	}
+	int resid = 0;
+	error = vn_rdwr(UIO_WRITE, vp, (caddr_t)text, length, 0, UIO_SYSSPACE,
+	    IO_NOAUTH | IO_UNIT, vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+	if (!error && resid) {
+		error = EIO;
+	}
+	if (!error) {
+		struct vnode_attr va;
+		VATTR_INIT(&va);
+		VATTR_SET(&va, va_mode, 0644);
+		VATTR_SET(&va, va_uid, 501);
+		VATTR_SET(&va, va_gid, 501);
+		error = vnode_setattr(vp, &va, ctx);
+	}
+	if (!error) {
+		error = VNOP_FSYNC(vp, MNT_WAIT, ctx);
+	}
+	int close_error = vnode_close(vp, FWRITE, ctx);
+	return error ? error : close_error;
+}
+
+int
+native_picasso_gpu_diag_write(const char *text, int length)
+{
+	static const char *const paths[] = {
+		"/private/var/mobile/Library/Preferences/picasso-gpu-diag.log",
+		"/private/var/mobile/picasso-gpu-diag.log",
+		"/private/var/picasso-gpu-diag.log",
+		"/private/var/tmp/picasso-gpu-diag.log",
+	};
+	int error = EINVAL;
+	if (!text || length <= 0) {
+		return -EINVAL;
+	}
+	for (unsigned i = 0; i < sizeof paths / sizeof paths[0]; ++i) {
+		error = native_picasso_gpu_diag_write_one(paths[i], text, length);
+		if (!error) {
+			return (int)(i + 1);
+		}
+	}
+	return error ? -error : -EIO;
+}
+
+/* Round 11: the kernel-side control writer. Called from exec context (the ca
+ * preferences hook), it records which process context the channel works from. */
+int
+native_picasso_gpu_diag_marker(const char *tag)
+{
+	char text[128];
+	int length = snprintf(text, sizeof text, "v11 tag=%s writer=exec-marker\n", tag);
+	int result;
+	if (length <= 0) {
+		return -EINVAL;
+	}
+	if (length >= (int)sizeof text) {
+		length = (int)sizeof text - 1;
+	}
+	result = native_picasso_gpu_diag_write(text, length);
+	printf("PICASSO_GPU_DIAG marker=%s result=%d\n", tag, result);
+	return result;
+}
 #endif
